{
  "name": "sardaunatechlab/corporate-api",
  "type": "project",
  "description": "The official Laravel backend API for Sardauna Tech Lab Ltd.",
  "keywords": ["laravel", "api", "sardauna-tech-lab"],
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "v11.43.2",
    "laravel/sanctum": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "policy": {
      "advisories": {
        "block": false,
        "ignore": ["*"]
      }
    },
    "audit": {
      "block": false,
      "ignore": ["*"]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

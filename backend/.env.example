APP_NAME="Sardauna Tech Lab API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos
APP_URL=https://api.sardaunatechlabs.com.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (DirectAdmin MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sardauna_db
DB_USERNAME=sardauna_user
DB_PASSWORD=YOUR_SECURE_MYSQL_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.sardaunatechlabs.com.ng

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Cache
CACHE_STORE=database
CACHE_PREFIX=stl_cache_

# DirectAdmin SMTP Configuration
MAIL_MAILER=smtp
MAIL_HOST=mail.sardaunatechlabs.com.ng
MAIL_PORT=465
MAIL_USERNAME=contact@sardaunatechlabs.com.ng
MAIL_PASSWORD=YOUR_DIRECTADMIN_EMAIL_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contact@sardaunatechlabs.com.ng"
MAIL_FROM_NAME="Sardauna Tech Lab Ltd"

# CORS Allowed Origins
SANCTUM_STATEFUL_DOMAINS="sardaunatechlabs.com.ng,www.sardaunatechlabs.com.ng,localhost:3000"
CORS_ALLOWED_ORIGINS="https://sardaunatechlabs.com.ng,https://www.sardaunatechlabs.com.ng,http://localhost:3000"
